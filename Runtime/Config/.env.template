# ==============================================================================
# NOESIS-Σ Runtime Configuration (.env.template)
# Copy to: Runtime/Config/.env   (then: chmod 600 Runtime/Config/.env)
# DO NOT COMMIT REAL SECRETS. Keep this file template in git; never the filled .env.
# ==============================================================================

# -------- Core engine knobs (picked up by EngineParams.from_env / Core.params.load_params) ------
NOESIS_DEVICE=cpu                 # cpu | cuda | cuda:0
NOESIS_DT=0.005                   # time step
NOESIS_STATE_DIM=1024             # default working dimension
NOESIS_MAX_NORM=16.0              # projection norm cap
NOESIS_SPECTRAL_CAP=1.0           # cap for ||K||_2 (engine rescales K if exceeded)
NOESIS_IMPLICIT_ITERS=1           # inner implicit iterations (1 is default & fast)
NOESIS_IMPLICIT_TOL=1e-6          # float32 tolerance (use 1e-4 for fp16)
NOESIS_CLIP_NAN_POLICY=raise      # raise | clamp | rewind
NOESIS_MAX_STEP_TIME_MS=200.0     # watchdog threshold per step (ms)

# -------- Snapshot crypto (file paths; keys live outside git) ----------------------------------
# Put real keys under Runtime/Config/keys/*  (generate via: bash Security/keygen.sh)
# NOTE:
# - Core.params.load_params() will read these paths and load bytes into EngineParams.
# - EngineParams.from_env() picks up the core numeric settings above; for keys/PEMs prefer load_params().
NOESIS_SNAPSHOT_AES_KEY_PATH=Runtime/Config/keys/model.aes.key
NOESIS_SNAPSHOT_SIGN_PRIVATE_PEM_PATH=Runtime/Config/keys/ed25519_private.pem
NOESIS_SNAPSHOT_SIGN_PUBLIC_PEM_PATH=Runtime/Config/keys/ed25519_public.pem

# -------- Advanced (optional; uncomment as needed) ---------------------------------------------
# Python bytecode cache location (keeps __pycache__ out of source tree)
# PYTHONPYCACHEPREFIX=Runtime/Cache

# SIM storage (S0)
# SIM_DB_URL=sqlite:///Runtime/Sim/sim.sqlite3
# SIM_DB_ECHO=0
# SIM_HOT_LRU_MAX_KEYS=2048
# SIM_HOT_DEFAULT_MAX_ITEMS=256
# SIM_PROFILE=BALANCED
# SIM_MASTER_KEY_B64=   # base64-encoded 32 bytes, required for encrypt_at_rest profiles
# SIM_ADMIN_API_KEY=    # required for ADMIN role
# SIM_SERVICE_API_KEY=  # required for SERVICE role

# Determinism & precision
# NOESIS_DETERMINISTIC=true
# NOESIS_ENABLE_JIT=false
# NOESIS_ENABLE_PROFILING=false
# NOESIS_ALLOW_MIXED_PRECISION=false   # if true and on CUDA, engine may use autocast for dissipative step

# Thermostat (used by Ops/thermostat.py hook; ignored if not wired)
# NOESIS_THERMOSTAT_DT_MIN=1e-5
# NOESIS_THERMOSTAT_WARN_THRESHOLD=3
# NOESIS_THERMOSTAT_SNAPSHOT_ON_TRIGGER=true

# ------------------------------------------------------------------------------
# SECURITY NOTES
# - Set strict permissions on the real .env: chmod 600 Runtime/Config/.env
# - Keys in Runtime/Config/keys/* should be mode 600 (private) / 644 (public PEM).
# - Ensure .gitignore excludes Runtime/Config/.env and Runtime/Config/keys/*
# ------------------------------------------------------------------------------
