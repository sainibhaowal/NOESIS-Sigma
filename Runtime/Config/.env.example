## Frontend auth / BFF
DATABASE_URL=postgresql://noesis:noesis@localhost:9010/noesis
RESEND_API_KEY=REPLACE_ME
RESEND_FROM_EMAIL=noesis@yourdomain.com
TENANT_ID_PEPPER=REPLACE_ME_STRONG_RANDOM
AUTH_IP_PEPPER=REPLACE_ME_STRONG_RANDOM
NOESIS_UUID_NAMESPACE=2f3f3b6e-7b9f-4d2c-a0a8-8c9f1c2f4d11
SESSION_SIGNING_SECRET=REPLACE_ME_STRONG_RANDOM
SESSION_TTL_DAYS=7
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

## Backend proxy keys
NOESIS_BACKEND_URL=http://localhost:9000
NOESIS_BACKEND_API_KEY=REPLACE_ME_BACKEND_KEY
NOESIS_INTERNAL_API_KEY=REPLACE_ME_INTERNAL_KEY

## Existing API / SIM security keys
NOESIS_REQUIRE_API_KEY=1
SIM_USER_API_KEY=REPLACE_ME_USER_KEY
SIM_ADMIN_API_KEY=REPLACE_ME_ADMIN_KEY
SIM_SERVICE_API_KEY=REPLACE_ME_SERVICE_KEY
SIM_MASTER_KEY_B64=REPLACE_ME

## Native decoder selection
# ACCEPTANCE_SUITE_PASSED=true
# USE_EXPRESSION_LAYER=true
# DECODER_MODE=sigma_emitter | expression_layer | auto
# Legacy alias DECODER_MODE=bridge maps to sigma_emitter.
DECODER_FALLBACK_TO_SIGMA_EMITTER=true
# Legacy env name still honored:
# DECODER_FALLBACK_TO_BRIDGE=true

## WKS embeddings (default: hash — no sentence-transformers). Use nomic only if you pip-install sentence-transformers.
# WKS_EMBEDDING_PROVIDER=hash

## HDC Encoder (Hyperdimensional Computing)
# Enable HDC encoding for structured facts
# USE_HDC_ENCODER=true

## GPU Hopfield WorldModel Cache
# Enable GPU-accelerated retrieval (0.05ms vs 5-20ms)
# USE_HOPFIELD_CACHE=true
